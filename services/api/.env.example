# Copy to services/api/.env. Every value has a development default in app/config.py.
ENV=development                      # development | test | production (production refuses the default JWT secret, disables /docs and seeding)
DATABASE_URL=sqlite:///./aurel.db    # PostgreSQL: postgresql+psycopg://aurel:password@localhost:5432/aurel
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=20
RESET_TOKEN_MINUTES=30
REFRESH_COOKIE_PATH=/api/auth        # browser path of the web proxy's auth routes
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
WEB_BASE_URL=http://localhost:3000   # used to build password-reset links
DEMO_DATA_ON_SIGNUP=true             # give new accounts synthetic reports, plan, tasks and appointments
RATE_LIMIT_ENABLED=true
TRUSTED_PROXIES=                     # e.g. 127.0.0.1,10.0.0.0/8 behind an edge that overwrites X-Forwarded-For; run uvicorn with --no-proxy-headers

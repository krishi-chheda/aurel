{
  "expo": {
    "name": "Aurel",
    "slug": "aurel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aurel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aurel.health",
      "associatedDomains": [
        "applinks:aurel.example"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F7F9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aurel.health",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aurel.example",
              "pathPrefix": "/dashboard"
            },
            {
              "scheme": "https",
              "host": "aurel.example",
              "pathPrefix": "/health"
            },
            {
              "scheme": "https",
              "host": "aurel.example",
              "pathPrefix": "/reports"
            },
            {
              "scheme": "https",
              "host": "aurel.example",
              "pathPrefix": "/care-plan"
            },
            {
              "scheme": "https",
              "host": "aurel.example",
              "pathPrefix": "/appointments"
            },
            {
              "scheme": "https",
              "host": "aurel.example",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "aurel.example",
              "pathPrefix": "/notifications"
            },
            {
              "scheme": "https",
              "host": "aurel.example",
              "pathPrefix": "/onboarding"
            },
            {
              "scheme": "https",
              "host": "aurel.example",
              "pathPrefix": "/support"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
# Server-only. The browser never sees it: all calls go through the same-origin /api proxy (next.config.ts).
# Read at build time by the rewrites, so rebuild after changing it.
API_URL=http://127.0.0.1:8000
# Only behind an edge proxy/load balancer that OVERWRITES X-Forwarded-For with the real client address.
# Otherwise src/proxy.ts strips client-supplied forwarding headers before they reach the API (audit AUD-09).
TRUST_EDGE_XFF=false
